# URL de la base SQLite. Es relativa a prisma/ dentro del contenedor,
# por eso apunta a /app/db/custom.db. No la cambies salvo que sepas lo que haces.
DATABASE_URL="file:../db/custom.db"

# Clave secreta para firmar los JWT. Genera una propia antes de desplegar.
JWT_SECRET="cambia-este-valor-por-una-clave-segura-larga-y-aleatoria"

# Puerto publicado en el host (el contenedor siempre escucha en 3000).
APP_PORT=3000

# Entorno de ejecución de Next.js.
NODE_ENV=production

# Si es true, la primera vez que se crea la BD se cargan los datos de ejemplo.
SEED_ON_START=true
