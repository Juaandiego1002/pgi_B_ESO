# Dependencias y artefactos de build (se instalan/generan dentro de la imagen)
node_modules
.next
out
build
coverage

# Control de versiones y entornos locales (nunca copies secretos a la imagen)
.git
.gitignore
.env
.env.*
!.env.example

# Base de datos local: se crea en un volumen al iniciar el contenedor
db/*.db
db/*.db-*
prisma/*.db
prisma/*.db-*

# Logs y archivos temporales
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
*.tsbuildinfo
next-env.d.ts

# Scripts de despliegue ajenos a Docker y descargas locales
.zscripts
tests
download
mini-services
local-*
